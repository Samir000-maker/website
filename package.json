{
  "name": "mood-app-backend",
  "version": "1.0.0",
  "description": "Mood tracking and social chat application backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:cluster": "pm2 start ecosystem.config.js",
    "start:cluster:dev": "pm2 start ecosystem.config.js --env development",
    "start:cluster:prod": "pm2 start ecosystem.config.js --env production",
    "stop": "pm2 stop webrtc-server",
    "restart": "pm2 restart webrtc-server",
    "reload": "pm2 reload webrtc-server",
    "logs": "pm2 logs webrtc-server",
    "monit": "pm2 monit",
    "delete": "pm2 delete webrtc-server"
  },
  "keywords": [
    "mood",
    "chat",
    "websocket",
    "firebase",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "^2.1514.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.9.2",
    "level": "^8.0.0",
    "mongodb": "^6.3.0",
    "multer": "^1.4.5-lts.1",
    "pidusage": "^3.0.0",
    "redlock": "^4.2.0",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
